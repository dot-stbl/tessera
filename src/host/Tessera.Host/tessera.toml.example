# Reference template (also shipped next to the binary on publish).
# Day-to-day: edit committed tessera.toml; machine overrides in
# tessera.local.toml (gitignored). Explicit path: TESSERA_CONFIG=...

[server]
host = "0.0.0.0"
port = 1990

[victoria]
tenant = "0"
timeout_ms = 5000

[victoria.traces]
url = "http://vt:10428"
token = "env:TESSERA_VICTORIA_TOKEN"

[victoria.logs]
url = "http://vl:9428"
token = "env:TESSERA_VICTORIA_TOKEN"

[victoria.metrics]
url = "http://vm:8428"
token = "env:TESSERA_VICTORIA_TOKEN"

[storage]
provider = "sqlite"

[telemetry]
service_name = "tessera"
otlp_endpoint = "http://localhost:4317"
enable_console_exporter = false
