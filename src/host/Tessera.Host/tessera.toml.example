# Template / alternate deploy shapes. Day-to-day defaults live in tessera.toml
# (vironima.internal). Overrides: tessera.local.toml (gitignored).

[server]
host = "0.0.0.0"
port = 1990

[victoria]
tenant = "0"
timeout_ms = 5000

[victoria.traces]
url = "https://vtraces.vironima.internal"

[victoria.logs]
url = "https://vlogs.vironima.internal"

[victoria.metrics]
url = "https://vmui.vironima.internal"

[storage]
provider = "sqlite"

[telemetry]
service_name = "tessera"
otlp_endpoint = "http://127.0.0.1:4317"
