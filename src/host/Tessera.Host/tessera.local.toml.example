# Copy to tessera.local.toml (gitignored) for machine-specific overrides.
# Loaded after tessera.toml — later keys win.
#
# Example: point at vironima after port-forward, or in-cluster DNS from a pod.

# [victoria.traces]
# url = "http://127.0.0.1:10428"
#
# [victoria.logs]
# url = "http://127.0.0.1:9428"
#
# [victoria.metrics]
# url = "http://127.0.0.1:8428"
