# Tessera local-override config — sample.
#
# Copy to `tessera.local.toml` next to `tessera.toml`. The host loads this
# AFTER the main file — keys here override the base config. Use for:
#   - per-host URLs (pointing at local Victoria stack)
#   - secrets-as-files (`token_file = "/etc/tessera/secrets/vt-token"`)
#   - dev-only tweaks (log_level = "debug")
#
# This file is gitignored. NEVER commit real secrets here.

# Example: point at a local dev Victoria stack
# [victoria.traces]
# url = "http://localhost:10428"

# Example: enable debug logging in dev
# [telemetry]
# log_level = "debug"